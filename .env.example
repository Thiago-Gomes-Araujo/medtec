# ==============================================================================
# MEDTEC Rondônia — Variáveis de Ambiente do Frontend (Next.js)
# ==============================================================================
# Copie este arquivo para .env.local para configurar seu ambiente de desenvolvimento:
# cp .env.example .env.local
# NUNCA insira senhas reais ou segredos de produção neste arquivo de exemplo.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Integração com a API Backend (Rails API v1)
# ------------------------------------------------------------------------------
# URL pública utilizada pelo navegador para consumir os endpoints da API v1:
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# URL interna utilizada pelo servidor Next.js (BFF / Server Components), se diferente:
BACKEND_API_URL=http://localhost:3000/api/v1

# Origem CORS necessária no backend Rails (arquivo .env da API: ALLOWED_ORIGINS):
# Exemplo para desenvolvimento Next.js: ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 2. Sessão Administrativa e Proteção de Rotas (Next.js Middleware / Cookies)
# ------------------------------------------------------------------------------
# Chave secreta para assinatura HMAC-SHA256 da sessão (mínimo de 32 caracteres em produção):
ADMIN_SESSION_SECRET=substitua-por-uma-chave-aleatoria-de-pelo-menos-32-caracteres

# Credenciais administrativas padrão (apenas fallback para ambiente de desenvolvimento local):
ADMIN_USER=admin
ADMIN_PASSWORD=senha_segura_desenvolvimento

# ------------------------------------------------------------------------------
# 3. Configurações Públicas do Frontend
# ------------------------------------------------------------------------------
# URL base do portal para geração de sitemap, robots e metadados OpenGraph:
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Provedor de tiles do mapa geográfico dos polos MEDTEC:
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png
