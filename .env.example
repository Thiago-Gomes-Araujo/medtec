# =====================================================================
# Variáveis de Ambiente do Portal Institucional MEDTEC (SEDUC-RO)
# Copie este arquivo para .env.local e preencha com valores seguros.
# NUNCA comite credenciais de produção no controle de versão.
# =====================================================================

# 1. Usuário administrador do painel gestor (CMS)
ADMIN_USER=admin

# 2. Senha de acesso do administrador (utilize senha forte em produção)
ADMIN_PASSWORD=

# 3. Chave secreta para assinatura criptográfica de sessões (HMAC-SHA256)
# OBRIGATÓRIA em ambiente de produção (mínimo de 32 caracteres).
# Você pode gerar uma chave segura no terminal com o comando:
# openssl rand -hex 32
ADMIN_SESSION_SECRET=
