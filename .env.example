# =====================================================================
# Variáveis de Ambiente do Portal Institucional MEDTEC (SEDUC-RO)
# Copie este arquivo para .env.local (desenvolvimento) ou configure no container
# NUNCA comite credenciais de produção no controle de versão.
# =====================================================================

# ---------------------------------------------------------------------
# 1. SERVIDOR & AUTENTICAÇÃO (Nunca expor ao cliente - Server-side only)
# ---------------------------------------------------------------------

# Usuário administrador do painel gestor (CMS)
ADMIN_USER=admin

# Senha de acesso do administrador (utilize senha forte em produção)
ADMIN_PASSWORD=

# Chave secreta para assinatura criptográfica de sessões (HMAC-SHA256)
# OBRIGATÓRIA em ambiente de produção (mínimo de 32 caracteres).
# Gere com: openssl rand -hex 32
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------
# 2. VARIÁVEIS PÚBLICAS DO FRONTEND (Prefixo NEXT_PUBLIC_)
# ---------------------------------------------------------------------

# URL Canônica oficial do portal para geração de sitemap e SEO
NEXT_PUBLIC_SITE_URL=https://medtec.seduc.ro.gov.br

# Provedor oficial de mapa de azulejos (Tiles OpenStreetMap / Carto CDN)
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png
